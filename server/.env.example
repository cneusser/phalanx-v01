# Vorlage für die Server-Umgebung. Echte Werte gehören NICHT ins Repo,
# sondern in Railway (Variables) bzw. in eine lokale, nicht getrackte server/.env.
#
# JWT_SECRET erzeugen (lange Zufallszeichenkette, >= 32 Zeichen):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

PORT=3001
NODE_ENV=development

# Pflicht in Produktion. Signiert Sessions UND Datei-/Share-Links.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend-Origin (Produktion), begrenzt CORS. Beispiel: https://app.example.com
FRONTEND_URL=

# Datenbank (Railway: Reference auf Postgres.DATABASE_URL)
DATABASE_URL=

# Optional: Bot-Schutz Cloudflare Turnstile (Site- und Secret-Key)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: Transaktions-Mails (Brevo)
BREVO_API_KEY=
# Optional: Secret für eingehende Mail-Webhooks (als Header x-inbound-secret senden)
INBOUND_SECRET=
